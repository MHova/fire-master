# Database (setup.sh fills these automatically)
POSTGRES_USER=firemaster
POSTGRES_PASSWORD=firemaster
POSTGRES_DB=firemaster
DATABASE_URL=postgresql+asyncpg://firemaster:firemaster@localhost:5432/firemaster
DATABASE_URL_SYNC=postgresql://firemaster:firemaster@localhost:5432/firemaster

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — setup.sh generates these. Do not commit real values.
JWT_SECRET_KEY=change-me-to-a-random-32-byte-hex-string
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=change-me-to-bcrypt-hash

# CORS (comma-separated origins, default localhost dev server)
CORS_ORIGINS=http://localhost:5173

# Monarch Money
MONARCH_SESSION_FILE=.monarch_session

# Anthropic (optional — only needed for in-app AI advisor, not Claude Code)
ANTHROPIC_API_KEY=

# App
APP_ENV=development
# Log every SQL statement to the console (debugging only — very noisy)
DATABASE_ECHO=false
