# Production frontend image: 2-stage build -> static site on nginx.
# Used by docker-compose.demo.yml (the hosted public demo) and by anyone
# self-hosting FIREMaster behind a real reverse proxy instead of the Vite
# dev server. API calls are relative /api, so the proxy in front decides
# where the backend lives — nothing is baked in at build time.
FROM node:20-slim AS build

WORKDIR /app

# Deps first for layer caching
COPY package*.json ./
RUN npm ci

# Build the static bundle (tsc -b && vite build)
COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
